// Data model per Technical Spec V2, section 5 (15 core entities + 3 fast-follow).
// Extra: RuleConfig (config-driven rules, e.g. marital filter) — spec 1 "rules are data, not code".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER_MANAGER
  STAFF
  ACCOUNTANT
}

enum SubscriptionTier {
  STARTER
  GROWTH
  CONCIERGERIE
  ENTERPRISE
}

enum LicenseStatus {
  LICENSED
  UNLICENSED
  PENDING
}

enum LicenseType {
  FURNISHED_APARTMENT
  RIAD
  MAISON_DHOTE
  AUBERGE
}

enum TaxRegime {
  PROPERTY_INCOME
  PROFESSIONAL
  COMPANY
}

enum TaxeSejourMode {
  INCLUDED
  COLLECTED
}

enum Residency {
  RESIDENT
  NON_RESIDENT
  MRE
}

enum BankAccountType {
  STANDARD
  CONVERTIBLE_DIRHAM
  FOREIGN_CURRENCY
}

enum BookingSource {
  AIRBNB
  BOOKING
  DIRECT
  OTHER
}

/// What a calendar event is. UNCERTAIN never counts until a person confirms it.
enum BookingClassification {
  BOOKING
  OWNER_BLOCK
  UNCERTAIN
}

enum ClassifiedBy {
  AUTO
  MANUAL
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum FeedStatus {
  NEVER
  OK
  ERROR
}

enum DocType {
  PASSPORT
  CIN
}

enum MaritalStatus {
  REQUIRED
  UPLOADED
  VERIFIED
  EXEMPT
}

enum ShareResourceType {
  FICHE_DE_POLICE
  POLICE_REGISTER
}

enum Severity {
  INFO
  AMBER
  RED
}

enum ChecklistStatus {
  TODO
  IN_PROGRESS
  DONE
  NOT_APPLICABLE
}

enum MessageChannel {
  WHATSAPP
  EMAIL
}

enum MessageSubject {
  CHECKIN_LINK
  ALERT
  SHARE_LINK
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  FELL_BACK // the WhatsApp send failed and the e-mail went instead
}

// Which channel a user wants for an alert type. NONE keeps the alert on screen only.
enum PreferredChannel {
  WHATSAPP
  EMAIL
  BOTH
  NONE
}

enum VendorType {
  TRANSPORT
  CATERING
  GUIDE
  OTHER
}

enum AddOnType {
  TRANSFER
  MEAL
  ALCOHOL
  TOUR
  OTHER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model Account {
  id               String           @id @default(uuid())
  companyName      String
  subscriptionTier SubscriptionTier @default(STARTER)
  billingStatus    String           @default("trial")
  seatLimit        Int              @default(1)
  createdAt        DateTime         @default(now())

  users           User[]
  invitations     Invitation[]
  owners          PropertyOwner[]
  properties      Property[]
  bookings        Booking[]
  icalFeeds       IcalFeed[]
  importBatches   ImportBatch[]
  shareLinks      ShareLink[]
  shareAccesses   ShareAccess[]
  policeRegisters PoliceRegister[]
  taxReports      TaxReport[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  vendors         Vendor[]
  storedObjects   StoredObject[]
  checkInLinks    CheckInLink[]
  guestCheckIns   GuestCheckIn[]
  fiches          FicheDePolice[]
  checklistItems  ChecklistItem[]
  deliveries      MessageDelivery[]
  preferences     NotificationPreference[]
}

model User {
  id           String    @id @default(uuid())
  accountId    String
  name         String
  email        String    @unique
  phone        String?
  role         Role
  passwordHash String
  lastLoginAt  DateTime?
  disabledAt   DateTime?
  /** Access tokens issued before this moment are refused (password reset, reuse detection, logout). */
  sessionsRevokedAt DateTime?
  createdAt    DateTime  @default(now())

  account             Account                  @relation(fields: [accountId], references: [id])
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  preferences         NotificationPreference[]

  @@unique([id, accountId])
  @@index([accountId])
}

// Rotating sessions. Only the hash of the 256-bit token is stored.
// Reuse of a revoked token revokes the whole chain (replacedById links rotations).
model RefreshToken {
  id           String    @id @default(uuid())
  userId       String
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  /** When the login this token descends from started; carried over on every rotation to cap a session's life. */
  familyStartedAt DateTime @default(now())
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Single-use reset links (1 hour).
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Staff / Accountant onboarding (7-day expiry). The role comes from here, never from the request body.
model Invitation {
  id          String    @id @default(uuid())
  accountId   String
  email       String
  role        Role
  tokenHash   String    @unique
  invitedBy   String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  resentAt    DateTime? // last re-send; the counter caps how often a link can be mailed again
  resendCount Int       @default(0)
  createdAt   DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([email])
}

model PropertyOwner {
  id              String          @id @default(uuid())
  accountId       String
  name            String
  taxId           String?
  residency       Residency
  bankAccountType BankAccountType @default(STANDARD)

  account    Account    @relation(fields: [accountId], references: [id])
  properties Property[]

  // Target of the composite (id, accountId) foreign keys: a child row can only point at a row of its own account.
  @@unique([id, accountId])
  @@index([accountId])
}

model Property {
  id             String         @id @default(uuid())
  accountId      String
  ownerId        String
  name           String
  address        String
  commune        String
  licenseStatus  LicenseStatus  @default(UNLICENSED)
  licenseType    LicenseType
  taxRegime      TaxRegime      @default(PROPERTY_INCOME)
  taxeSejourMode TaxeSejourMode @default(COLLECTED)
  icalUrl        String?
  createdAt      DateTime       @default(now())

  account         Account          @relation(fields: [accountId], references: [id])
  owner           PropertyOwner    @relation(fields: [ownerId, accountId], references: [id, accountId])
  bookings        Booking[]
  icalFeeds       IcalFeed[]
  importBatches   ImportBatch[]
  checklistItems  ChecklistItem[]
  policeRegisters PoliceRegister[]
  taxReports      TaxReport[]
  notifications   Notification[]
  addOns          AddOnService[]

  @@unique([id, accountId])
  @@index([accountId])
}

// Monetary amounts are Decimal(12,2) MAD.
// Past stays are frozen: a booking whose checkout is in the past is never deleted or cancelled by a sync,
// even if the platform trimmed it from the feed.
model Booking {
  id                 String                @id @default(uuid())
  accountId          String
  propertyId         String
  feedId             String?
  importBatchId      String?
  checkIn            DateTime              @db.Date
  checkOut           DateTime              @db.Date
  partySize          Int?
  nightlyRevenue     Decimal?              @db.Decimal(12, 2)
  cleaningFee        Decimal?              @db.Decimal(12, 2)
  addonRevenue       Decimal?              @db.Decimal(12, 2)
  discounts          Decimal?              @db.Decimal(12, 2)
  refunds            Decimal?              @db.Decimal(12, 2)
  platformCommission Decimal?              @db.Decimal(12, 2)
  taxeSejourAmount   Decimal?              @db.Decimal(12, 2)
  source             BookingSource
  externalUid        String? // iCal UID, for idempotent sync
  confirmationCode   String? // platform reference or import key, for idempotent imports
  summary            String? // trimmed event summary; never a guest name from an import
  classification     BookingClassification @default(BOOKING)
  classifiedBy       ClassifiedBy          @default(AUTO)
  status             BookingStatus         @default(CONFIRMED)
  cancelledAt        DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  account      Account        @relation(fields: [accountId], references: [id])
  property     Property       @relation(fields: [propertyId, accountId], references: [id, accountId])
  feed         IcalFeed?      @relation(fields: [feedId], references: [id], onDelete: SetNull)
  importBatch  ImportBatch?   @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  checkIns     GuestCheckIn[]
  checkInLinks CheckInLink[]
  orders       AddOnOrder[]

  @@unique([feedId, externalUid])
  @@unique([propertyId, source, confirmationCode])
  // Targets of composite tenant foreign keys (check-in links, guests).
  @@unique([id, accountId])
  @@unique([id, propertyId, accountId])
  @@index([accountId])
  @@index([propertyId, checkIn])
}

// The iCal URL is a secret: anyone holding it can read the calendar. Owner/Manager only; never logged.
model IcalFeed {
  id           String        @id @default(uuid())
  accountId    String
  propertyId   String
  platform     BookingSource
  url          String
  lastSyncedAt DateTime?
  lastStatus   FeedStatus    @default(NEVER)
  lastError    String? // sanitised: never contains the URL
  eventCount   Int           @default(0)
  createdAt    DateTime      @default(now())

  account  Account   @relation(fields: [accountId], references: [id])
  property Property  @relation(fields: [propertyId, accountId], references: [id, accountId], onDelete: Cascade)
  bookings Booking[]

  @@unique([propertyId, platform])
  @@index([accountId])
}

model ImportBatch {
  id            String   @id @default(uuid())
  accountId     String
  propertyId    String
  fileName      String
  rowCount      Int
  importedCount Int
  errorCount    Int
  createdBy     String
  createdAt     DateTime @default(now())

  account  Account   @relation(fields: [accountId], references: [id])
  property Property  @relation(fields: [propertyId, accountId], references: [id, accountId], onDelete: Cascade)
  bookings Booking[]

  @@index([accountId])
  @@index([propertyId])
}

enum GuestCheckInStatus {
  PENDING // draft: a document was uploaded, the form is not submitted yet
  SUBMITTED
  VERIFIED // reviewed by the manager
}

// A link the manager sends for one booking. Only the SHA-256 of the token is stored; the token itself is shown once.
// Valid until `expiresAt` (checkout + RuleConfig checkin.link_grace_hours), revocable, limited to maxGuests submissions.
model CheckInLink {
  id              String    @id @default(uuid())
  accountId       String
  bookingId       String
  tokenHash       String    @unique
  expiresAt       DateTime
  revokedAt       DateTime?
  createdBy       String // user id
  guestsSubmitted Int       @default(0)
  maxGuests       Int
  createdAt       DateTime  @default(now())

  account Account        @relation(fields: [accountId], references: [id])
  booking Booking        @relation(fields: [bookingId, accountId], references: [id, accountId])
  guests  GuestCheckIn[]

  @@unique([id, accountId])
  @@index([accountId])
  @@index([bookingId])
}

// Highest-risk data: one row per adult guest. The ID image is an encrypted StoredObject that the retention job
// deletes after the window; the structured fields are kept. propertyId always matches the booking's property
// (one composite key covers booking, property and account).
model GuestCheckIn {
  id                          String             @id @default(uuid())
  accountId                   String
  bookingId                   String
  propertyId                  String
  linkId                      String
  guestIndex                  Int? // 1-based position in the party; assigned at submission (a draft has none)
  status                      GuestCheckInStatus @default(PENDING)
  fullName                    String?
  nationality                 String?
  declaredMoroccanNationality Boolean            @default(false)
  docType                     DocType?
  docNumber                   String?
  dob                         DateTime?          @db.Date
  docExpiryDate               DateTime?          @db.Date
  docImageId                  String? // StoredObject id, never a URL
  ocrConfidence               Float?
  ocrFieldsFlagged            Json? // {status, flagged, edited, suggestedHashes}: field names and hashes only, never values
  uploadCount                 Int                @default(0) // document photos sent for this draft (max 3)
  entryStampNumber            String?
  cityOfOrigin                String?
  nextDestination             String?
  profession                  String?
  consentTextId               String? // the exact wording (version and language) the guest agreed to
  consentAt                   DateTime?
  createdAt                   DateTime           @default(now())
  submittedAt                 DateTime?

  account         Account          @relation(fields: [accountId], references: [id])
  booking         Booking          @relation(fields: [bookingId, propertyId, accountId], references: [id, propertyId, accountId])
  link            CheckInLink      @relation(fields: [linkId, accountId], references: [id, accountId])
  docImage        StoredObject?    @relation(fields: [docImageId, accountId], references: [id, accountId], onDelete: Restrict)
  consentText     ConsentText?     @relation(fields: [consentTextId], references: [id])
  maritalDocument MaritalDocument?
  fiche           FicheDePolice?

  @@unique([id, accountId])
  @@unique([bookingId, guestIndex])
  @@index([accountId])
  @@index([bookingId])
  @@index([linkId])
}

// Wording shown above the submit button, one row per (version, language). Only rows with approvedAt set are ever
// served: the text comes from counsel and is inserted by a migration or SQL, never written by the app.
model ConsentText {
  id         String    @id @default(uuid())
  version    String
  locale     String // fr | en
  body       String
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime  @default(now())

  guests GuestCheckIn[]

  @@unique([version, locale])
}

model MaritalDocument {
  id             String        @id @default(uuid())
  guestCheckInId String        @unique
  fileUrl        String?
  status         MaritalStatus @default(REQUIRED)
  verifiedBy     String?
  exemptReason   String?
  uploadedAt     DateTime?
  expiresAt      DateTime?

  guestCheckIn GuestCheckIn @relation(fields: [guestCheckInId], references: [id])
}

// One per guest; regenerating replaces the PDF (the previous StoredObject is deleted). The PDF is an encrypted StoredObject.
model FicheDePolice {
  id              String   @id @default(uuid())
  accountId       String
  guestCheckInId  String   @unique
  pdfObjectId     String
  templateVersion String
  sha256          String // of the PDF
  generatedAt     DateTime @default(now())

  account      Account      @relation(fields: [accountId], references: [id])
  guestCheckIn GuestCheckIn @relation(fields: [guestCheckInId, accountId], references: [id, accountId])
  pdf          StoredObject @relation(fields: [pdfObjectId, accountId], references: [id, accountId])

  @@unique([guestCheckInId, accountId]) // required by Prisma for the composite one-to-one key
  @@index([accountId])
}

// One register per property and month (Phase 4). Regenerating replaces the row and shreds the previous PDF.
// `validation` holds counts by problem, never names or document numbers.
model PoliceRegister {
  id              String   @id @default(uuid())
  accountId       String
  propertyId      String
  month           String // YYYY-MM
  pdfObjectId     String
  templateVersion String
  sha256          String // of the PDF
  inputDigest     String // digest of the data the PDF was built from: a different digest now means the register is outdated
  guestCount      Int
  validation      Json
  generatedBy     String // user id
  generatedAt     DateTime @default(now())

  account  Account      @relation(fields: [accountId], references: [id])
  property Property     @relation(fields: [propertyId, accountId], references: [id, accountId])
  pdf      StoredObject @relation(fields: [pdfObjectId, accountId], references: [id, accountId])

  @@unique([propertyId, month])
  @@unique([id, accountId])
  @@index([accountId])
  @@index([pdfObjectId])
}

// A time-limited link to one Fiche or one register. `resourceId` is polymorphic, so no foreign key can hold it:
// the service checks it against the account and a test guards that. Only the hash of the token is stored.
model ShareLink {
  id             String            @id @default(uuid())
  accountId      String
  resourceType   ShareResourceType
  resourceId     String
  tokenHash      String            @unique // only the hash of the 256-bit token is stored
  recipientLabel String // manager-only, never shown to the recipient
  expiresAt      DateTime
  revokedAt      DateTime?
  maxViews       Int? // unused: view limits are out of scope for Phase 4
  viewCount      Int               @default(0)
  createdBy      String
  createdAt      DateTime          @default(now())

  account  Account       @relation(fields: [accountId], references: [id])
  accesses ShareAccess[]

  @@unique([id, accountId])
  @@index([accountId])
  @@index([resourceType, resourceId])
}

// One row per successful view. Failed attempts store nothing, so attacker-supplied input never lands here.
// No IP address: whether an authority's access must be attributable is an open decision for counsel.
model ShareAccess {
  id          String   @id @default(uuid())
  accountId   String
  shareLinkId String
  at          DateTime @default(now())
  userAgent   String // trimmed

  account Account   @relation(fields: [accountId], references: [id])
  share   ShareLink @relation(fields: [shareLinkId, accountId], references: [id, accountId])

  @@index([shareLinkId, at])
  @@index([accountId])
}

// Rates/thresholds are data validated by a fiduciaire — never hard-coded.
model TaxRule {
  id             String      @id @default(uuid())
  commune        String
  licenseType    LicenseType
  taxeSejourRate Decimal     @db.Decimal(8, 2) // MAD per person per night
  tptRate        Decimal     @db.Decimal(8, 2)
  basis          String      @default("PER_PERSON_NIGHT")
  effectiveFrom  DateTime    @db.Date
  validatedBy    String?
  validatedAt    DateTime?

  @@unique([commune, licenseType, effectiveFrom])
}

// Config-driven rules (marital filter conditions, mandatory fields, IR/VAT rates & thresholds, retention days).
model RuleConfig {
  key         String    @id
  value       Json
  validatedBy String?
  validatedAt DateTime?
  updatedAt   DateTime  @updatedAt
}

// A monthly tax ESTIMATE for one property (Phase 5). Money columns are Decimal(12,2) MAD; the lines carry integer
// centimes. `ruleVersions` says which RuleConfig / TaxRule rows produced the figures and whether each was validated,
// so a report built on unvalidated rules is always labelled as a beta estimate.
model TaxReport {
  id                 String           @id @default(uuid())
  accountId          String
  propertyId         String
  month              String // YYYY-MM
  regime             TaxRegime
  nightsRevenue      Decimal          @db.Decimal(12, 2)
  addonRevenue       Decimal          @db.Decimal(12, 2)
  grossBase          Decimal          @db.Decimal(12, 2)
  taxeSejourDeducted Decimal          @db.Decimal(12, 2)
  vatTotal           Decimal          @db.Decimal(12, 2)
  incomeTaxTotal     Decimal          @db.Decimal(12, 2)
  localTaxTotal      Decimal          @db.Decimal(12, 2)
  bankAccountType    BankAccountType?
  lines              Json // ordered report lines (integer centimes, or null when not computed)
  problems           Json // missing-data problems by booking id, never names
  ruleVersions       Json // [{ key, validated, validatedAt }]
  unvalidated        Boolean // true when any rule used is not validated: exports carry the beta watermark
  inputDigest        String // a different digest now means the report is outdated
  pdfObjectId        String
  xlsxObjectId       String
  templateVersion    String
  disclaimerVersion  String
  generatedBy        String // user id
  generatedAt        DateTime         @default(now())

  account  Account      @relation(fields: [accountId], references: [id])
  property Property     @relation(fields: [propertyId, accountId], references: [id, accountId])
  pdf      StoredObject @relation("TaxReportPdf", fields: [pdfObjectId, accountId], references: [id, accountId])
  xlsx     StoredObject @relation("TaxReportXlsx", fields: [xlsxObjectId, accountId], references: [id, accountId])

  @@unique([propertyId, month])
  @@unique([id, accountId])
  @@index([accountId])
  @@index([pdfObjectId])
  @@index([xlsxObjectId])
}

// The licensing steps for a city and licence type. Global reference data like TaxRule: not tenant data.
// The list of steps is a legal statement, so it is seeded only from counsel's list and carries `validatedBy`;
// while it is NULL the app labels the checklist "not validated" and never presents it as the legal list.
model ChecklistTemplateStep {
  id               String       @id @default(uuid())
  code             String // stable identifier of the step within its city, e.g. used when the template is revised
  cityScope        String       @default("Marrakech")
  licenseTypeScope LicenseType? // null = every licence type
  condition        String? // e.g. "meals": the step applies only when the property meets it
  position         Int
  nameFr           String
  nameEn           String
  validatedBy      String?
  validatedAt      DateTime?
  createdAt        DateTime     @default(now())

  items ChecklistItem[]

  @@unique([cityScope, code])
  @@index([cityScope, licenseTypeScope, position])
}

// A step copied to a property when its licence type is set, so it can be ticked and annotated per property
// while the template evolves. The supporting document is an encrypted StoredObject, never a URL.
model ChecklistItem {
  id               String          @id @default(uuid())
  accountId        String
  propertyId       String
  templateStepId   String
  status           ChecklistStatus @default(TODO)
  dueDate          DateTime?       @db.Date
  note             String?
  documentObjectId String?
  updatedBy        String? // user id
  updatedAt        DateTime        @default(now()) @updatedAt
  createdAt        DateTime        @default(now())

  account      Account               @relation(fields: [accountId], references: [id])
  property     Property              @relation(fields: [propertyId, accountId], references: [id, accountId])
  templateStep ChecklistTemplateStep @relation(fields: [templateStepId], references: [id])
  document     StoredObject?         @relation(fields: [documentObjectId, accountId], references: [id, accountId])

  @@unique([propertyId, templateStepId])
  @@unique([id, accountId])
  @@index([accountId])
  @@index([documentObjectId])
}

// One row per message attempt on a channel. Never the body, the link, the token or the recipient's number:
// only what is needed to show a status and to make a delivery report idempotent.
model MessageDelivery {
  id                String         @id @default(uuid())
  accountId         String
  channel           MessageChannel
  template          String // name of the approved template (WhatsApp) or of the e-mail
  subjectType       MessageSubject
  subjectId         String // polymorphic: checked against the account by the service, so no foreign key
  status            MessageStatus  @default(QUEUED)
  providerMessageId String? // the provider's id, used to match delivery reports
  failureCode       String? // a fixed code from our own list, never a provider message
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @default(now()) @updatedAt

  account Account @relation(fields: [accountId], references: [id])

  @@unique([id, accountId])
  @@unique([channel, providerMessageId])
  @@index([accountId, subjectType, subjectId])
}

model NotificationPreference {
  id        String           @id @default(uuid())
  accountId String
  userId    String
  alertType String // e.g. day_counter.amber
  channel   PreferredChannel
  updatedAt DateTime         @default(now()) @updatedAt

  account Account @relation(fields: [accountId], references: [id])
  user    User    @relation(fields: [userId, accountId], references: [id, accountId], onDelete: Cascade)

  @@unique([userId, alertType])
  @@index([accountId])
}

model Notification {
  id         String    @id @default(uuid())
  accountId  String
  type       String
  severity   Severity  @default(INFO)
  propertyId String?
  bookingId  String?
  year       Int? // threshold alerts: one per type, property and year
  message    String
  sentVia    String[]
  readAt     DateTime?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  account  Account   @relation(fields: [accountId], references: [id])
  property Property? @relation(fields: [propertyId], references: [id])

  @@unique([accountId, type, propertyId, year])
  @@index([accountId, resolvedAt])
}

model AuditLog {
  id           String   @id @default(uuid())
  accountId    String
  actorId      String?
  action       String
  resourceType String
  resourceId   String
  ip           String?
  createdAt    DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id])

  @@index([accountId, createdAt])
}

// One row per encrypted object in private storage. The object is AES-256-GCM ciphertext under a per-object
// data key; wrappedKey is that key wrapped by a master key (never stored in the database in clear).
// Deleting an object also blanks wrappedKey (crypto-shredding: copies left in backups become unreadable).
enum StoredObjectKind {
  ID_IMAGE
  FICHE_PDF
  POLICE_REGISTER_PDF
  TAX_REPORT_PDF
  TAX_REPORT_XLSX
  LICENSE_DOCUMENT
}

model StoredObject {
  id         String           @id @default(uuid())
  accountId  String
  key        String           @unique // object key: random, never derived from personal data
  kind       StoredObjectKind
  sizeBytes  Int // plaintext size
  sha256     String // of the plaintext
  wrappedKey String
  createdAt  DateTime         @default(now())
  expiresAt  DateTime? // retention purge date
  deletedAt  DateTime?

  account     Account          @relation(fields: [accountId], references: [id])
  guestDocs   GuestCheckIn[]
  fiches      FicheDePolice[]
  registers   PoliceRegister[]
  taxPdfs     TaxReport[]      @relation("TaxReportPdf")
  taxXlsxs    TaxReport[]      @relation("TaxReportXlsx")
  licenseDocs ChecklistItem[]

  @@unique([id, accountId])
  @@index([accountId])
  @@index([deletedAt, expiresAt]) // the retention job scans by this
}

// ---- Fast-follow ----

model Vendor {
  id            String     @id @default(uuid())
  accountId     String
  type          VendorType
  companyName   String
  licenseNumber String?
  driverPhone   String?
  docUrl        String?
  expiresAt     DateTime?

  account Account        @relation(fields: [accountId], references: [id])
  addOns  AddOnService[]

  @@index([accountId])
}

model AddOnService {
  id            String    @id @default(uuid())
  propertyId    String
  type          AddOnType
  price         Decimal   @db.Decimal(12, 2)
  vendorId      String?
  licenseDocUrl String?
  enabled       Boolean   @default(false)

  property Property     @relation(fields: [propertyId], references: [id])
  vendor   Vendor?      @relation(fields: [vendorId], references: [id])
  orders   AddOnOrder[]
}

model AddOnOrder {
  id         String      @id @default(uuid())
  bookingId  String
  serviceId  String
  amount     Decimal     @db.Decimal(12, 2)
  commission Decimal     @db.Decimal(12, 2)
  status     OrderStatus @default(PENDING)

  booking Booking      @relation(fields: [bookingId], references: [id])
  service AddOnService @relation(fields: [serviceId], references: [id])
}
