# Copy to .env — never commit real values. Validated at boot by apps/api/src/config/env.ts.
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3000
# Proxy hops in front of the API (Next.js /api proxy = 1). Wrong value = wrong client IPs in rate limits and audit.
TRUST_PROXY=1
# console = dev only (prints reset/invitation links). Production: brevo (EU) or resend, with MAIL_API_KEY (provider choice still open).
MAIL_DRIVER=console
# MAIL_API_KEY=
MAIL_FROM=Dari <no-reply@localhost>
# Required. Generate: openssl rand -base64 48 (placeholders are refused in production)
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_S=900
REFRESH_TOKEN_TTL_DAYS=30
# Leave unset: secure cookies in production, plain HTTP allowed in development.
# COOKIE_SECURE=
# Calendar sync: every N hours (queue, needs Redis); fetch caps; ICAL_ALLOW_INSECURE=true allows http/private hosts in dev only.
ICAL_SYNC_INTERVAL_HOURS=2
ICAL_FETCH_TIMEOUT_MS=10000
ICAL_MAX_BYTES=2097152
ICAL_ALLOW_INSECURE=false
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
DATABASE_URL=postgresql://dari:dari@localhost:5432/dari
# Optional in development (in-memory fallbacks); required in production. Tests use TEST_REDIS_URL (flushed!).
REDIS_URL=redis://localhost:6379
# Guest check-in and Fiche de Police. On when unset in development; OFF by default in production until the legal gates are closed.
# GUEST_CHECKIN_ENABLED=true
# Private object storage for ID scans and Fiche PDFs. Everything is encrypted by the API before upload.
# memory = dev/test only (ephemeral key, nothing persisted). s3 = MinIO in dev, a private bucket in production.
STORAGE_DRIVER=memory
# Wraps the per-object data keys: `id:base64`, newest first. Required with s3 and in production.
# Generate: echo "k1:$(openssl rand -base64 32)". Rotate by adding a new first entry, never by editing one.
# STORAGE_MASTER_KEYS=
# Production also needs S3_SSE=true (provider-side encryption on top) and an https S3_ENDPOINT (or none for AWS).
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=dari-private
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_SSE=false
# Document worker (services/ocr), private network only. Shared secret: openssl rand -base64 32 (32+ characters; the worker refuses to start without it).
OCR_SERVICE_URL=http://localhost:8001
OCR_SHARED_SECRET=
# WhatsApp Cloud API (Meta) — requires business verification
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
