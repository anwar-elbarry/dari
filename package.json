{
  "name": "dari",
  "private": true,
  "version": "0.1.0",
  "description": "Morocco STR Compliance & Tax Platform",
  "workspaces": ["apps/api", "apps/web"],
  "scripts": {
    "lint": "eslint apps",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace apps/api",
    "db:generate": "npm run db:generate --workspace apps/api",
    "db:validate": "npm run db:validate --workspace apps/api",
    "dev:api": "npm run start:dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
